# 複製成 .env 後填入自己的值:cp .env.example .env
#
# 本專案只透過「OpenAI 相容介面」接 LLM,所以下面任何一組端點都能用:
#   Ollama（自架,免金鑰）   CHAT_BASE_URL=http://localhost:11434/v1
#   NVIDIA NIM              CHAT_BASE_URL=https://integrate.api.nvidia.com/v1
#   OpenAI                  CHAT_BASE_URL=https://api.openai.com/v1
# 多數 provider 的 base url 需以 /v1 結尾（client 會自行接上 /chat/completions）。

# ── Chat（必填）────────────────────────────────────────────────
CHAT_BASE_URL=http://localhost:11434/v1
CHAT_API_KEY=
CHAT_MODEL=qwen3:8b

# ── Embedding ─────────────────────────────────────────────────
# BASE_URL / API_KEY 留空則沿用上面 chat 的設定
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
# 需與 database/sql/schema.sql 的 VECTOR(n) 一致
EMBEDDING_DIM=1024

# ── 租戶 ──────────────────────────────────────────────────────
# 目前沒有身分驗證,租戶由 X-Tenant-Id header 帶入;沒帶就用這個值
DEFAULT_TENANT_ID=default

# ── 資料庫 ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:secret@localhost:5433/enterprise_rag
